{
  "UserPromptSubmit": [
    {
      "hooks": [
        {
          "type": "http",
          "url": "https://headkey.ai/api/v1/hooks/ingest",
          "headers": {
            "Authorization": "Bearer ${HEADKEY_API_KEY}",
            "X-Headkey-Agent-Id": "${HEADKEY_AGENT_ID:-}"
          }
        }
      ]
    }
  ],
  "Stop": [
    {
      "hooks": [
        {
          "type": "http",
          "url": "https://headkey.ai/api/v1/hooks/ingest",
          "headers": {
            "Authorization": "Bearer ${HEADKEY_API_KEY}",
            "X-Headkey-Agent-Id": "${HEADKEY_AGENT_ID:-}"
          }
        }
      ]
    }
  ]
}
